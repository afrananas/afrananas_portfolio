{
  "name": "afrananas-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "serve": "wrangler dev --port 8788 --ip 127.0.0.1",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:css": "node scripts/check-css-tokens.mjs",
    "test": "vitest run tests/unit",
    "test:build": "vitest run tests/build",
    "test:e2e": "playwright test",
    "lhci": "npx --yes @lhci/cli@0.15.1 autorun",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run format:check && npm run lint && npm run check && npm run check:css && npm test && npm run build && npm run test:build && npm run test:e2e",
    "test:e2e:fallback": "E2E_SERVER=preview E2E_CHANNEL=chrome playwright test --project=chromium-desktop --project=chromium-mobile"
  },
  "dependencies": {
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "workerd": true
  }
}
