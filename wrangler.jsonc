// Cloudflare Workers static assets, no Worker script (ADR-005).
// Routing behavior: docs/03-architecture/routing-and-page-model.md
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "afrananas-portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "workers_dev": true,
  "preview_urls": true,
}
